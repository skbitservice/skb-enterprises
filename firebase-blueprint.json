{
  "entities": {
    "User": {
      "title": "User",
      "description": "Information corresponding to registered user accounts",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Firebase Auth UID of the user"
        },
        "name": {
          "type": "string",
          "description": "Full name of the client"
        },
        "email": {
          "type": "string",
          "description": "Verified email of the client"
        },
        "phone": {
          "type": "string",
          "description": "Primary phone contact"
        },
        "address": {
          "type": "string",
          "description": "Delivery address inside NCR"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when this profile fell into sync"
        }
      },
      "required": ["id", "name", "email", "phone", "createdAt"]
    },
    "Booking": {
      "title": "Booking",
      "description": "A notebook repair booking record in deep-level laboratory states",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique booking identifier generated by system"
        },
        "userId": {
          "type": "string",
          "description": "Auth ID of the booking initiator"
        },
        "brand": {
          "type": "string",
          "description": "Hardware brand e.g. HP, Lenovo"
        },
        "model": {
          "type": "string",
          "description": "Laptop model name"
        },
        "serialNumber": {
          "type": "string",
          "description": "Optional physical device serial number"
        },
        "issues": {
          "type": "array",
          "description": "Array of laptop issue IDs"
        },
        "additionalNotes": {
          "type": "string",
          "description": "Anomalies, special requests or remarks provided"
        },
        "quoteAmount": {
          "type": "number",
          "description": "Calibrated diagnostic repair quote in standard INR"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "received", "diagnosing", "repairing", "ready", "delivered"],
          "description": "Current status phase of the notebook repair block"
        },
        "scheduledDate": {
          "type": "string",
          "description": "Preferred service selection slot time"
        },
        "serviceType": {
          "type": "string",
          "enum": ["home_pickup", "store_visit"],
          "description": "Operational ingress type preferred by device owner"
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["pending", "paid"],
          "description": "Financial cleared status from Nehru Complex gateways"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "System timestamp corresponding to booking insertion"
        }
      },
      "required": ["id", "userId", "brand", "model", "issues", "quoteAmount", "status", "scheduledDate", "serviceType", "paymentStatus", "createdAt"]
    },
    "PartPurchase": {
      "title": "PartPurchase",
      "description": "Authentic physical spare parts sales transaction invoice history",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Order code generated by Spare Depot"
        },
        "userId": {
          "type": "string",
          "description": "ID corresponding to buying customer"
        },
        "partId": {
          "type": "string",
          "description": "ID marking item purchased"
        },
        "partName": {
          "type": "string",
          "description": "System name representing hardware piece"
        },
        "price": {
          "type": "number",
          "description": "Unit rate in INR"
        },
        "quantity": {
          "type": "number",
          "description": "Total quantity ordered of spare hardware"
        },
        "totalAmount": {
          "type": "number",
          "description": "Consolidated total price paid"
        },
        "status": {
          "type": "string",
          "enum": ["processing", "shipped", "delivered"],
          "description": "Logistics deployment status of physical part"
        },
        "shippingAddress": {
          "type": "string",
          "description": "Delivery address of client and telemetry logistics"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Checkout finalization timestamp"
        }
      },
      "required": ["id", "userId", "partId", "partName", "price", "quantity", "totalAmount", "status", "shippingAddress", "createdAt"]
    },
    "LaptopPart": {
      "title": "LaptopPart",
      "description": "Authentic physical spare part item in catalog",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "SKU code generated by system"
        },
        "name": {
          "type": "string",
          "description": "Commercial catalog name"
        },
        "type": {
          "type": "string",
          "enum": ["adapter", "battery", "motherboard", "screen", "ram", "ssd"],
          "description": "Hardware category"
        },
        "brand": {
          "type": "string",
          "description": "Manufacturer brand e.g. HP, Lenovo"
        },
        "compatibleModels": {
          "type": "array",
          "description": "Applicable laptop configurations"
        },
        "price": {
          "type": "number",
          "description": "Individual purchase rate in INR"
        },
        "stock": {
          "type": "number",
          "description": "Current quantity in storage"
        },
        "description": {
          "type": "string",
          "description": "Details and specs"
        },
        "image": {
          "type": "string",
          "description": "Asset URL"
        }
      },
      "required": ["id", "name", "type", "brand", "compatibleModels", "price", "stock", "description", "image"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Access profile records of registered users"
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Repair scheduling log documents mapped by unique IDs"
    },
    "/purchases/{purchaseId}": {
      "schema": { "$ref": "#/entities/PartPurchase" },
      "description": "Checkout transactions tracking spare part shipments inside NCR"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/LaptopPart" },
      "description": "Global catalog list of available spare parts"
    }
  }
}
